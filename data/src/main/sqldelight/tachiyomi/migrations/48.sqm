import kotlin.Boolean;

-- KMK: anime library tables (merged from Anikku)
CREATE TABLE animes(
    _id INTEGER NOT NULL PRIMARY KEY,
    source INTEGER NOT NULL,
    url TEXT NOT NULL,
    artist TEXT,
    author TEXT,
    description TEXT,
    genre TEXT,
    title TEXT NOT NULL,
    status INTEGER NOT NULL,
    thumbnail_url TEXT,
    background_url TEXT,
    favorite INTEGER AS Boolean NOT NULL,
    initialized INTEGER AS Boolean NOT NULL,
    date_added INTEGER NOT NULL,
    last_update INTEGER NOT NULL DEFAULT 0,
    fetch_type INTEGER NOT NULL DEFAULT 1,
    episode_flags INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX kmk_animes_favorite_index ON animes(favorite) WHERE favorite = 1;

CREATE INDEX kmk_animes_url_index ON animes(url);

CREATE TABLE episodes(
    _id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    url TEXT NOT NULL,
    name TEXT NOT NULL,
    scanlator TEXT,
    summary TEXT,
    preview_url TEXT,
    seen INTEGER AS Boolean NOT NULL DEFAULT 0,
    bookmark INTEGER AS Boolean NOT NULL DEFAULT 0,
    fillermark INTEGER AS Boolean NOT NULL DEFAULT 0,
    last_second_seen INTEGER NOT NULL DEFAULT 0,
    total_seconds INTEGER NOT NULL DEFAULT 0,
    episode_number REAL NOT NULL,
    source_order INTEGER NOT NULL,
    date_fetch INTEGER NOT NULL,
    date_upload INTEGER NOT NULL,
    FOREIGN KEY(anime_id) REFERENCES animes (_id)
    ON DELETE CASCADE
);

CREATE INDEX kmk_episodes_anime_id_index ON episodes(anime_id);
