-- KMK: anime categories
CREATE TABLE anime_categories(
    _id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sort INTEGER NOT NULL
);

CREATE TABLE animes_categories(
    _id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    category_id INTEGER NOT NULL,
    UNIQUE (anime_id, category_id),
    FOREIGN KEY(anime_id) REFERENCES animes (_id)
    ON DELETE CASCADE,
    FOREIGN KEY(category_id) REFERENCES anime_categories (_id)
    ON DELETE CASCADE
);

CREATE INDEX kmk_animes_categories_anime_id_index ON animes_categories(anime_id);
