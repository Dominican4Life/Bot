import kotlin.Boolean;

-- KMK: episodes of anime (merged from Anikku)
CREATE TABLE episodes(
    _id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    url TEXT NOT NULL,
    name TEXT NOT NULL,
    scanlator TEXT,
    summary TEXT,
    preview_url TEXT,
    seen INTEGER AS Boolean NOT NULL DEFAULT 0,
    bookmark INTEGER AS Boolean NOT NULL DEFAULT 0,
    fillermark INTEGER AS Boolean NOT NULL DEFAULT 0,
    last_second_seen INTEGER NOT NULL DEFAULT 0,
    total_seconds INTEGER NOT NULL DEFAULT 0,
    episode_number REAL NOT NULL,
    source_order INTEGER NOT NULL,
    date_fetch INTEGER NOT NULL,
    date_upload INTEGER NOT NULL,
    FOREIGN KEY(anime_id) REFERENCES animes (_id)
    ON DELETE CASCADE
);

CREATE INDEX kmk_episodes_anime_id_index ON episodes(anime_id);

getByAnimeId:
SELECT * FROM episodes WHERE anime_id = :animeId ORDER BY source_order;

getById:
SELECT * FROM episodes WHERE _id = :id;

insert:
INSERT INTO episodes(anime_id, url, name, scanlator, summary, preview_url, fillermark, episode_number, source_order, date_fetch, date_upload)
VALUES (:animeId, :url, :name, :scanlator, :summary, :previewUrl, :fillermark, :episodeNumber, :sourceOrder, :dateFetch, :dateUpload);

updateFromSource:
UPDATE episodes SET
    name = :name,
    scanlator = :scanlator,
    summary = :summary,
    preview_url = :previewUrl,
    fillermark = :fillermark,
    episode_number = :episodeNumber,
    source_order = :sourceOrder,
    date_upload = :dateUpload
WHERE _id = :id;

setSeen:
UPDATE episodes SET seen = :seen WHERE _id = :id;

setBookmark:
UPDATE episodes SET bookmark = :bookmark WHERE _id = :id;

setProgress:
UPDATE episodes SET last_second_seen = :lastSecondSeen, total_seconds = :totalSeconds WHERE _id = :id;

deleteById:
DELETE FROM episodes WHERE _id = :id;

deleteByAnimeId:
DELETE FROM episodes WHERE anime_id = :animeId;

updatePartial:
UPDATE episodes SET
    seen = coalesce(:seen, seen),
    bookmark = coalesce(:bookmark, bookmark),
    fillermark = coalesce(:fillermark, fillermark),
    last_second_seen = coalesce(:lastSecondSeen, last_second_seen),
    total_seconds = coalesce(:totalSeconds, total_seconds)
WHERE _id = :id;

getUpdates:
SELECT
    an._id AS animeId,
    an.source,
    an.title,
    an.thumbnail_url,
    ep._id AS episodeId,
    ep.name AS episodeName,
    ep.episode_number,
    ep.seen,
    ep.bookmark,
    ep.last_second_seen,
    ep.total_seconds,
    ep.date_fetch
FROM episodes ep
JOIN animes an ON ep.anime_id = an._id
WHERE an.favorite = 1 AND ep.date_fetch > an.date_added AND ep.date_fetch > :after
ORDER BY ep.date_fetch DESC
LIMIT :limit;

getByUrl:
SELECT * FROM episodes WHERE anime_id = :animeId AND url = :url LIMIT 1;

-- KMK: per-anime numbers for the anime library's filters, sorts and badges
animeLibraryStats:
SELECT
    ep.anime_id AS animeId,
    COUNT(*) AS total,
    coalesce(SUM(CASE WHEN ep.seen = 1 THEN 1 ELSE 0 END), 0) AS seenCount,
    coalesce(SUM(CASE WHEN ep.bookmark = 1 THEN 1 ELSE 0 END), 0) AS bookmarkCount,
    coalesce(SUM(CASE WHEN ep.seen = 0 AND ep.last_second_seen > 0 THEN 1 ELSE 0 END), 0) AS inProgressCount,
    coalesce(MAX(ep.date_upload), 0) AS latestUpload,
    coalesce(MAX(ep.date_fetch), 0) AS latestFetch,
    coalesce(MAX(h.last_seen), 0) AS lastSeen
FROM episodes ep
LEFT JOIN anime_history h ON h.episode_id = ep._id
GROUP BY ep.anime_id;
