import kotlin.Boolean;

-- KMK: episodes of anime (merged from Anikku)
CREATE TABLE episodes(
    _id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    url TEXT NOT NULL,
    name TEXT NOT NULL,
    scanlator TEXT,
    summary TEXT,
    preview_url TEXT,
    seen INTEGER AS Boolean NOT NULL DEFAULT 0,
    bookmark INTEGER AS Boolean NOT NULL DEFAULT 0,
    fillermark INTEGER AS Boolean NOT NULL DEFAULT 0,
    last_second_seen INTEGER NOT NULL DEFAULT 0,
    total_seconds INTEGER NOT NULL DEFAULT 0,
    episode_number REAL NOT NULL,
    source_order INTEGER NOT NULL,
    date_fetch INTEGER NOT NULL,
    date_upload INTEGER NOT NULL,
    FOREIGN KEY(anime_id) REFERENCES animes (_id)
    ON DELETE CASCADE
);

CREATE INDEX kmk_episodes_anime_id_index ON episodes(anime_id);

getByAnimeId:
SELECT * FROM episodes WHERE anime_id = :animeId ORDER BY source_order;

insert:
INSERT INTO episodes(anime_id, url, name, scanlator, summary, preview_url, fillermark, episode_number, source_order, date_fetch, date_upload)
VALUES (:animeId, :url, :name, :scanlator, :summary, :previewUrl, :fillermark, :episodeNumber, :sourceOrder, :dateFetch, :dateUpload);

updateFromSource:
UPDATE episodes SET
    name = :name,
    scanlator = :scanlator,
    summary = :summary,
    preview_url = :previewUrl,
    fillermark = :fillermark,
    episode_number = :episodeNumber,
    source_order = :sourceOrder,
    date_upload = :dateUpload
WHERE _id = :id;

setSeen:
UPDATE episodes SET seen = :seen WHERE _id = :id;

setBookmark:
UPDATE episodes SET bookmark = :bookmark WHERE _id = :id;

setProgress:
UPDATE episodes SET last_second_seen = :lastSecondSeen, total_seconds = :totalSeconds WHERE _id = :id;

deleteById:
DELETE FROM episodes WHERE _id = :id;
