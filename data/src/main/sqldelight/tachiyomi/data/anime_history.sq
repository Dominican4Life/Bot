-- KMK: anime watch history (merged from Anikku)
CREATE TABLE anime_history(
    _id INTEGER NOT NULL PRIMARY KEY,
    episode_id INTEGER NOT NULL UNIQUE,
    last_seen INTEGER NOT NULL,
    time_watch INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(episode_id) REFERENCES episodes (_id)
    ON DELETE CASCADE
);

CREATE INDEX kmk_anime_history_episode_id_index ON anime_history(episode_id);

upsert:
INSERT INTO anime_history(episode_id, last_seen)
VALUES (:episodeId, :lastSeen)
ON CONFLICT(episode_id)
DO UPDATE SET last_seen = :lastSeen
WHERE episode_id = :episodeId;

-- KMK: add watched milliseconds to an episode's history row, creating it (last seen now) if missing
addTimeWatch:
INSERT INTO anime_history(episode_id, last_seen, time_watch)
VALUES (:episodeId, :now, :millis)
ON CONFLICT(episode_id)
DO UPDATE SET time_watch = time_watch + :millis
WHERE episode_id = :episodeId;

-- KMK: total watched milliseconds (for Stats)
getTotalTimeWatch:
SELECT coalesce(SUM(time_watch), 0) FROM anime_history;

getHistory:
SELECT
    an._id AS animeId,
    an.source,
    an.title,
    an.thumbnail_url,
    an.favorite,
    ep._id AS episodeId,
    ep.name AS episodeName,
    ep.episode_number,
    ep.last_second_seen,
    ep.total_seconds,
    hi.last_seen
FROM anime_history hi
JOIN episodes ep ON hi.episode_id = ep._id
JOIN animes an ON ep.anime_id = an._id
WHERE hi.last_seen > 0
ORDER BY hi.last_seen DESC;

getAll:
SELECT hi.episode_id, hi.last_seen FROM anime_history hi;

removeByAnimeId:
DELETE FROM anime_history
WHERE episode_id IN (SELECT _id FROM episodes WHERE anime_id = :animeId);

removeAll:
DELETE FROM anime_history;
