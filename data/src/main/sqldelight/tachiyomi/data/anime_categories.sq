import kotlin.Boolean;

-- KMK: categories of the anime library, kept apart from the manga ones. Anime in none of them are "Default".
CREATE TABLE anime_categories(
    _id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sort INTEGER NOT NULL,
    hidden INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE TABLE animes_categories(
    _id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    category_id INTEGER NOT NULL,
    UNIQUE (anime_id, category_id),
    FOREIGN KEY(anime_id) REFERENCES animes (_id)
    ON DELETE CASCADE,
    FOREIGN KEY(category_id) REFERENCES anime_categories (_id)
    ON DELETE CASCADE
);

CREATE INDEX kmk_animes_categories_anime_id_index ON animes_categories(anime_id);

getAll:
SELECT _id, name, sort, hidden FROM anime_categories ORDER BY sort;

insert:
INSERT INTO anime_categories(name, sort) VALUES (:name, :sort);

rename:
UPDATE anime_categories SET name = :name WHERE _id = :id;

setSort:
UPDATE anime_categories SET sort = :sort WHERE _id = :id;

setHidden:
UPDATE anime_categories SET hidden = :hidden WHERE _id = :id;

delete:
DELETE FROM anime_categories WHERE _id = :id;

-- Which categories every anime in the library is in
getLibraryLinks:
SELECT ac.anime_id, ac.category_id
FROM animes_categories ac
JOIN animes an ON an._id = ac.anime_id
WHERE an.favorite = 1;

getCategoryIdsOfAnime:
SELECT category_id FROM animes_categories WHERE anime_id = :animeId;

removeAnimeFromCategories:
DELETE FROM animes_categories WHERE anime_id = :animeId;

addAnimeToCategory:
INSERT OR IGNORE INTO animes_categories(anime_id, category_id) VALUES (:animeId, :categoryId);
