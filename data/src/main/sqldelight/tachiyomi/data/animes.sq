import kotlin.Boolean;

-- KMK: anime library (merged from Anikku). Kept separate from the manga tables.
CREATE TABLE animes(
    _id INTEGER NOT NULL PRIMARY KEY,
    source INTEGER NOT NULL,
    url TEXT NOT NULL,
    artist TEXT,
    author TEXT,
    description TEXT,
    genre TEXT,
    title TEXT NOT NULL,
    status INTEGER NOT NULL,
    thumbnail_url TEXT,
    background_url TEXT,
    favorite INTEGER AS Boolean NOT NULL,
    initialized INTEGER AS Boolean NOT NULL,
    date_added INTEGER NOT NULL,
    last_update INTEGER NOT NULL DEFAULT 0,
    fetch_type INTEGER NOT NULL DEFAULT 1,
    episode_flags INTEGER NOT NULL DEFAULT 0,
    -- KMK: seasons (migration 56). A season is an anime row whose parent_id is the anime it belongs to.
    parent_id INTEGER,
    season_flags INTEGER NOT NULL DEFAULT 0,
    season_number REAL NOT NULL DEFAULT -1,
    season_source_order INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX kmk_animes_favorite_index ON animes(favorite) WHERE favorite = 1;
CREATE INDEX kmk_animes_url_index ON animes(url);
CREATE INDEX kmk_animes_parent_id_index ON animes(parent_id);

getById:
SELECT * FROM animes WHERE _id = :id;

getByUrlAndSource:
SELECT * FROM animes WHERE url = :url AND source = :source LIMIT 1;

-- KMK: the library. A season is left out when its parent is in the library (the parent stands for it).
getFavorites:
SELECT * FROM animes
WHERE favorite = 1
AND (parent_id IS NULL OR parent_id NOT IN (SELECT _id FROM animes WHERE favorite = 1))
ORDER BY title COLLATE NOCASE;

-- KMK: every anime marked as favorite, seasons included (backups)
getAllFavorites:
SELECT * FROM animes WHERE favorite = 1 ORDER BY title COLLATE NOCASE;

-- KMK: seasons of the anime in the library, favorite or not (backups)
getSeasonsOfFavorites:
SELECT * FROM animes
WHERE parent_id IS NOT NULL AND parent_id IN (SELECT _id FROM animes WHERE favorite = 1)
ORDER BY parent_id, season_source_order;

getSeasonsByParentId:
SELECT * FROM animes WHERE parent_id = :parentId ORDER BY season_source_order;

setSeasonInfo:
UPDATE animes SET
    parent_id = :parentId,
    season_number = :seasonNumber,
    season_source_order = :seasonSourceOrder
WHERE _id = :id;

removeParent:
UPDATE animes SET parent_id = NULL WHERE _id IN :ids;

setSeasonFlags:
UPDATE animes SET season_flags = :flags WHERE _id = :id;

insert:
INSERT INTO animes(source, url, artist, author, description, genre, title, status, thumbnail_url, background_url, favorite, initialized, date_added, fetch_type)
VALUES (:source, :url, :artist, :author, :description, :genre, :title, :status, :thumbnailUrl, :backgroundUrl, 0, :initialized, 0, :fetchType);

updateDetails:
UPDATE animes SET
    title = :title,
    artist = :artist,
    author = :author,
    description = :description,
    genre = :genre,
    status = :status,
    thumbnail_url = coalesce(:thumbnailUrl, thumbnail_url),
    background_url = coalesce(:backgroundUrl, background_url),
    initialized = :initialized,
    fetch_type = :fetchType,
    last_update = :lastUpdate
WHERE _id = :id;

updateThumbnailIfNotFavorite:
UPDATE animes SET title = :title, thumbnail_url = coalesce(:thumbnailUrl, thumbnail_url)
WHERE _id = :id AND favorite = 0;

setFavorite:
UPDATE animes SET favorite = :favorite, date_added = :dateAdded WHERE _id = :id;

-- KMK: a no-op write so screens watching an anime read it again (after Edit info)
touch:
UPDATE animes SET episode_flags = episode_flags WHERE _id = :id;

setEpisodeFlags:
UPDATE animes SET episode_flags = :flags WHERE _id = :id;

selectLastInsertedRowId:
SELECT last_insert_rowid();
